Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: head_rgbd_sensor_rgb_frame
    Background Color: 40; 40; 40
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: RGBD colored points
      Enabled: true
      Topic:
        Value: /head_rgbd_sensor/depth_registered/demo_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Alpha: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Pitch: 0.3
      Yaw: 0.7
